# ============ Django ============
# 生产环境必须设置为 0
DEBUG=0
# 生产环境必须替换为随机长字符串: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=please-change-me-to-a-random-secret-key
# 允许访问的主机，逗号分隔
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend

# ============ MySQL 8.0 ============
MYSQL_DATABASE=campus_market
MYSQL_USER=campus
MYSQL_PASSWORD=campus123456
MYSQL_ROOT_PASSWORD=root123456
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ============ Redis 7 ============
# 默认缓存库 0
REDIS_URL=redis://redis:6379/0
# Celery Broker 库 1
CELERY_BROKER_URL=redis://redis:6379/1
# Celery 结果后端库 2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============ 业务配置 ============
# 订单超时未支付自动取消的秒数（默认 30 分钟）
ORDER_TIMEOUT_SECONDS=1800

# ============ 跨域（本地开发前端直连后端时使用） ============
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173